{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-matters-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "moneymatters.kaesava.au",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_NEON_AUTH_URL": "https://ep-spring-snow-a70f61xz.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth",
    "NEXT_PUBLIC_API_URL": "https://api.kaesava.au/trpc"
  }
}
