{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-matters-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "moneymatters.kaesava.au",
      "custom_domain": true,
      "zone_name": "kaesava.au"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_NEON_AUTH_URL": "https://ep-spring-snow-a70f61xz.neonauth.ap-southeast-2.aws.neon.tech/neondb/auth",
    "NEXT_PUBLIC_API_URL": "https://api.moneymatters.kaesava.au",
    "NEXT_PUBLIC_ENABLE_AUTH": "false",
    "NEXT_PUBLIC_STRIPE_PRICE_MONTHLY": "price_1U4dACDVJmou3Bno9z4KQIHh",
    "NEXT_PUBLIC_STRIPE_PRICE_ANNUAL": "price_1U4dACDVJmou3BnojoFMJDWF",
    "NEXT_PUBLIC_STRIPE_PRICE_FOUNDING_ANNUAL": "price_1U4dACDVJmou3BnoQyuBCg8E",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN": "phc_tUCUwzeZTkRaNB6RiqsaPf3rbTCAKY2Y9YMApkySf735",
    "NEXT_PUBLIC_SENTRY_DSN": "https://d72687a1414b1e142f6e5c8d815300da@o4511408239738880.ingest.us.sentry.io/4511834184679424"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
