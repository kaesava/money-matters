# =============================================================================
# Money Matters — Environment Variable Reference
# Copy this file to .env.development (local) or set via your deployment platform.
# NEVER commit .env or .env.production to version control.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Neon Auth (Better Auth) ---
NEXT_PUBLIC_NEON_AUTH_URL=https://your-project.neonauth.aws.neon.tech/neondb
NEON_AUTH_JWKS_URL=https://your-project.neonauth.aws.neon.tech/neondb/jwks.json
NEON_AUTH_BASE_URL=https://your-project.neonauth.aws.neon.tech/neondb

# --- Inngest (async workflows) ---
INNGEST_SIGNING_KEY=signkey-prod-replace-me
INNGEST_EVENT_KEY=replace-me

# --- Resend (transactional email) ---
RESEND_API_KEY=re_replace_me

# --- Cloudflare R2 (file storage) ---
STORAGE_BUCKET_NAME=money-matters-production
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
GLOBAL_MAX_FILE_SIZE_MB=10

# --- Redis / Rate Limiter (Upstash) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# --- Sentry (error monitoring) ---
SENTRY_DSN_API=https://replace@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://replace@sentry.io/project

# --- App ---
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

SENTRY_DSN=replace-me
