{
  "name": "money-matters-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/capabilities/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-i18n": "turbo run check-i18n",
    "dev": "npx concurrently -k -p \"[{name}]\" -n \"app,inngest,dbstudio\" -c \"cyan,magenta,black\" \"turbo run dev\" \"pnpm run dev:inngest\" \"pnpm run db:studio\"",
    "dev:inngest": "npx inngest-cli@latest dev -u https://kesh-imac.tail09ef18.ts.net/api/inngest",
    "db:studio": "pnpm --filter=@money-matters/db studio",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "audit:schema": "node scripts/audit-schema-usage.mjs",
    "validate": "pnpm check-i18n && pnpm audit:schema && turbo run typecheck lint test:coverage test && turbo run build",
    "version:bump": "node scripts/version-bump.mjs",
    "seed": "pnpm --filter @money-matters/db seed",
    "seed:prod": "pnpm --filter @money-matters/db seed:prod",
    "mobile:build:preview": "pnpm --filter @money-matters/mobile build:preview",
    "mobile:build:prod": "pnpm --filter @money-matters/mobile build:prod",
    "mobile:build:submit": "pnpm --filter @money-matters/mobile build:submit"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/node": "20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "connect": "^3.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "turbo": "2.0.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "~19.1.10",
      "@types/react-dom": "^19.0.0",
      "vite": "^6.0.0",
      "react-native-screens": "4.16.0",
      "react-native-svg": "15.12.1",
      "@expo/vector-icons": "15.1.1",
      "@react-native-community/datetimepicker": "8.4.4",
      "expo-constants": "~18.0.14"
    }
  },
  "type": "module",
  "dependencies": {
    "react-native-web": "^0.21.0"
  }
}
